{
  "name": "kaplay-webmcp",
  "version": "0.1.0",
  "description": "Expose running KAPLAY games to browser agents through WebMCP.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinesh/kaplayground.git",
    "directory": "packages/kaplay-webmcp"
  },
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "NOTICE.md",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:example": "vite build examples/running-game --config vite.config.ts --outDir ../../dist/example --emptyOutDir",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:consumer": "npm run build && tsc -p tsconfig.consumer.json",
    "example": "vite examples/running-game --config vite.config.ts --host 127.0.0.1",
    "prepare": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "peerDependencies": {
    "kaplay": ">=3001.0.0 <4000.0.0 || >=4000.0.0-alpha.0 <4001.0.0"
  },
  "dependencies": {
    "webmcp-types": "^0.1.5"
  },
  "devDependencies": {
    "kaplay": "^3001.0.19",
    "typescript": "^5.9.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
